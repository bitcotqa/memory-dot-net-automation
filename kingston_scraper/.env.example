# Copy to .env and edit as needed. All of these have sane defaults in
# config/config.py; you only need this file to override them.

HEADLESS=true
# Persistent cookies/session improve headed CAPTCHA handling. Use an empty
# value for an ephemeral browser profile.
BROWSER_PROFILE_DIR=state/browser_profile
CAPTCHA_WAIT_SECONDS=180
NAV_TIMEOUT_MS=45000
ACTION_TIMEOUT_MS=15000
POST_LOAD_SETTLE_MS=2500

REQUEST_DELAY_SECONDS=4.0
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=5.0

# Circuit breaker: after this many servers fail in a row, pause for
# COOLDOWN_SECONDS before continuing instead of retrying at the same fast
# cadence forever. See README "Known limitation: Cloudflare".
COOLDOWN_TRIGGER_STREAK=2
COOLDOWN_SECONDS=90

# The initial HTML already contains every spec/part (see README) — this
# exploratory-click pass is a fallback for an unseen page structure and
# adds automated-looking DOM interaction with no data upside, so it's off
# by default.
ENABLE_EXPLORATORY_CLICKS=false

SAVE_DEBUG_HTML_ON_FAILURE=true
